---
import { getLangStaticPaths, langFromParam, useTranslations } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLangStaticPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang)['404'];
---

<Layout lang={lang} title="Protop International" current="news">
  <main class="centre padding">
    <p class="pad"></p>
    <h1>{t.title}</h1>
    <h4>{t.message}</h4>
  </main>
</Layout>
