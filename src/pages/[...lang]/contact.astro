---
import '../../styles/contact.css';

import { Mail, MapPin, Phone, Printer } from 'lucide-react';

import Banner from '../../components/Banner.astro';
import ContactForm from '../../components/ContactForm';
import { getLangStaticPaths, langFromParam, useTranslations } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLangStaticPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang).contact;

const offices = [
  { ...t.hongKong, email: 'randy@protopintl.com', phone: '+852 2688 0083', fax: '+852 2688 0031' },
  { ...t.dongGuan, email: 'may@protopintl.com', phone: '+86 136 8626 7843', fax: undefined },
];
const tel = (n: string) => 'tel:' + n.replace(/\s/g, '');
---

<Layout lang={lang} title="Protop International | Contact Us" current="contact">
  <main>
    <Banner title={t.title} />
    <div class="padding textcontent">
      <div class="locations">
        {offices.map((o) => (
          <div class="l_card">
            <div class="l_img">
              <img src="https://placehold.co/600x400?text=Site+Under+\n+Contruction" alt="" />
            </div>
            <div class="address">
              <h2>{o.title}</h2>
              <p>
                <MapPin className="inline_icon" aria-hidden="true" />
                <span>{o.address[0]}</span>
              </p>
              {o.address.slice(1).map((line) => (
                <p class="c_tab">{line}</p>
              ))}
              <p>
                <Mail className="inline_icon" aria-hidden="true" />
                <a href={`mailto:${o.email}`}>{o.email}</a>
              </p>
              <p>
                <Phone className="inline_icon" aria-hidden="true" />
                <a href={tel(o.phone)}>{o.phone}</a>
              </p>
              {o.fax && (
                <p>
                  <Printer className="inline_icon" aria-hidden="true" />
                  <span>
                    {o.fax} {t.fax}
                  </span>
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="form">
      <div class="padding">
        <h2>{t.inquire.title}</h2>
        <ContactForm client:visible t={t.inquire} />
      </div>
    </div>
  </main>
</Layout>
