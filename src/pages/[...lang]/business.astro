---
import '../../styles/business.css';

import Banner from '../../components/Banner.astro';
import { getLangStaticPaths, langFromParam, useTranslations } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths = getLangStaticPaths;

const lang = langFromParam(Astro.params.lang);
const t = useTranslations(lang).business;
---

<Layout lang={lang} title="Protop International | Our Business" current="business">
  <main>
    <Banner />
    <div>
      <div class="padding textcontent">
        <h1>{t.title}</h1>
        <p>{t.intro}</p>
      </div>
      <ul class="b_projects">
        <li class="b_project">
          <div class="padding">
            <div class="bp_logo">
              <img src="/images/in_logo.avif" alt="Instyler" />
            </div>
            <p>{t.instyler.text1}</p>
            <div>
              <img src="/images/INSTYLER_TURBO.png" alt="Instyler Turbo" />
            </div>
            <p>{t.instyler.text2}</p>
          </div>
        </li>
        <li class="b_project">
          <div class="padding">
            <div class="bp_logo">
              <img
                style="mix-blend-mode: difference"
                src="/images/bbros_logo.avif"
                alt="Bananabros"
              />
            </div>
            <p>{t.bananabros.text1}</p>
            <div>
              <img
                srcset="/images/BBros.webp 841w, /images/BBros_wide.webp 1630w"
                sizes="(max-width: 900px) 841px, 1600px"
                src="/images/BBros_wide.webp"
                alt="Bananabros grinder photo"
              />
            </div>
            <p>{t.bananabros.text2}</p>
          </div>
        </li>
      </ul>
    </div>
  </main>
</Layout>
