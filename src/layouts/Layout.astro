---
import '../styles/styles.css';
import '../styles/head_foot.css';

import { ClientRouter } from 'astro:transitions';

import Footer from '../components/Footer.astro';
import Header from '../components/Header';
import type { NavKey } from '../components/links';
import type { Lang } from '../i18n';
import { stripLang, useTranslations } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  current?: NavKey;
  description?: string;
}

const { lang, title, current, description } = Astro.props;
const t = useTranslations(lang);
const htmlLang = { en: 'en', zh: 'zh-Hans', hk: 'zh-Hant-HK' }[lang];
---

<!doctype html>
<html lang={htmlLang} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="keywords" content="protopintl.com" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      type="image/webp"
      href="https://placehold.co/600x600/a91111/white/webp?text=PTI"
    />
    <title>{title}</title>
    <!-- swap pages in place instead of full reloads; the header persists across pages -->
    <ClientRouter />
  </head>
  <body>
    <Header
      client:load
      transition:persist="header"
      lang={lang}
      links={t.links}
      current={current}
      path={stripLang(Astro.url.pathname)}
    />
    <slot />
    <Footer lang={lang} links={t.links} />
    <script>
      const REVEAL = 'main h2, .highlights > li, .steps > li, .categories > li, .feature, .vision blockquote, .brands li, .l_card, .form, .cta';
      document.addEventListener('astro:page-load', () => {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e, i) => {
            const el = e.target as HTMLElement;
            if (e.isIntersecting) {
              el.style.transitionDelay = `${i * 80}ms`;
              el.classList.add('shown');
            } else if (e.boundingClientRect.top > 0) {
              // reset only once it drops below the viewport, so it replays on the next scroll down
              el.style.transitionDelay = '0ms';
              el.classList.remove('shown');
            }
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        const els = [...document.querySelectorAll(REVEAL)];
        // skip anything nested inside another block so whole blocks animate, not their contents
        els.filter((el) => !els.some((p) => p !== el && p.contains(el))).forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      });
    </script>
  </body>
</html>
