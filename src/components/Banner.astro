---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="crop">
  <img
    srcset="/images/peakpx700.jpg 900w, /images/peakpx.jpg 1920w"
    sizes="100vw"
    src="/images/peakpx.jpg"
    alt=""
  />
  {(title || subtitle) && (
    <div class="banner_text">
      {title && <h1>{title}</h1>}
      {subtitle && <p>{subtitle}</p>}
    </div>
  )}
</div>
