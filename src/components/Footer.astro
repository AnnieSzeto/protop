---
import type { Lang, Translations } from '../i18n';
import { localizePath } from '../i18n';
import { navLinks } from './links';

interface Props {
  lang: Lang;
  links: Translations['links'];
}

const { lang, links } = Astro.props;
---

<footer>
  <div class="f_proTop">
    <div class="f_logo">
      <img src="https://placehold.co/600x600/a81111/white?text=PTI" alt="Protop logo" />
    </div>
    <div>
      <p>Pro Top</p>
      <p>International Co. Ltd</p>
    </div>
  </div>
  <div class="f_links">
    <div>
      {navLinks.map(({ key, path }) => (
        <a href={localizePath(path, lang)}>{links[key]}</a>
      ))}
    </div>
  </div>
</footer>
